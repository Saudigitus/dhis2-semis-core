#!/usr/bin/env sh

# Evita loop infinito
[ "$SEMIS_SUBTREE_SYNC" = "1" ] && exit 0

# Fix para Windows: garante line endings corretos
if [ -z "$BASH_VERSION" ]; then
    exec bash "$0" "$@"
fi

# ==================== CONFIGURAÇÃO ====================
SUBTREES='
src/modules/attendance|attendance
src/modules/enrollment|enrollment
src/modules/final-result|final-result
src/modules/performance|performance
src/modules/school-calendar|school-calendar
src/modules/transfer|transfer
src/modules/transfer-execute|transfer-execute
'

CACHE_DIR=".git/subtree-cache"
LOG_FILE=".git/subtree-sync.log"

# ==================== FUNÇÕES RÁPIDAS ====================

# Obtém apenas diretórios alterados
get_changed_subtrees() {
    git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | \
    grep '^src/modules/' | \
    cut -d'/' -f1-3 | \
    sort -u
}

# Push otimizado
fast_push() {
    folder=$1
    remote_name=$2
    branch=$3
    
    split_branch="split-$remote_name"
    cache_file="$CACHE_DIR/$remote_name-$branch"
    
    mkdir -p "$CACHE_DIR" 2>/dev/null
    
    # Verifica hash do subtree
    subtree_hash=$(git log -1 --format=%H -- "$folder" 2>/dev/null || echo "")
    cached_hash=$(cat "$cache_file" 2>/dev/null || echo "")
    
    # Skip se cache hit
    if [ "$subtree_hash" = "$cached_hash" ] && [ -n "$cached_hash" ]; then
        echo "  ✨ $remote_name (cache)"
        return 0
    fi
    
    # Verifica se há alterações reais (HEAD~1 pode não existir no primeiro commit)
    if git rev-parse HEAD~1 >/dev/null 2>&1; then
        if git diff --quiet HEAD~1 HEAD -- "$folder" 2>/dev/null; then
            echo "  ⏭️  $remote_name (sem mudanças)"
            return 0
        fi
    fi
    
    remote_url="https://github.com/Saudigitus/dhis2-semis-$remote_name.git"
    
    # Split com rejoin (mais rápido com cache)
    if git subtree split --prefix="$folder" --branch="$split_branch" --rejoin --ignore-joins >/dev/null 2>&1; then
        # Push silencioso
        if git push -q "$remote_url" "$split_branch:$branch" 2>&1 | grep -qE "Everything up-to-date|Total|Already up to date"; then
            echo "$subtree_hash" > "$cache_file"
            echo "  ✅ $remote_name"
            git branch -D "$split_branch" >/dev/null 2>&1 || true
            return 0
        else
            echo "  ⚠️  $remote_name (push falhou - primeira vez na branch?)"
            git branch -D "$split_branch" >/dev/null 2>&1 || true
            return 1
        fi
    else
        echo "  ℹ️  $remote_name (split falhou - sem histórico?)"
        return 0
    fi
}

# ==================== EXECUÇÃO ====================
sync_all() {
    branch=$(git rev-parse --abbrev-ref HEAD)
    changed=$(get_changed_subtrees)
    
    if [ -z "$changed" ]; then
        echo "  ℹ️  Nenhum subtree alterado"
        return 0
    fi
    
    export SEMIS_SUBTREE_SYNC=1
    
    echo "  📂 Alterados: $(echo "$changed" | tr '\n' ' ')"
    echo ""
    
    # Processa em paralelo (máximo 3)
    count=0
    max_parallel=3
    
    echo "$SUBTREES" | while IFS='|' read -r folder remote_name; do
        [ -z "$folder" ] && continue
        
        # Verifica se mudou
        echo "$changed" | grep -q "^$folder$" || continue
        
        # Executa sequencialmente (mais estável no Windows)
        fast_push "$folder" "$remote_name" "$branch"
    done
    
    unset SEMIS_SUBTREE_SYNC
}

# ==================== MAIN ====================
{
    echo ""
    echo "🌿 SEMIS Sync | $(date +%H:%M:%S)"
    
    if sync_all; then
        echo ""
        echo "  🎉 Completo!"
    else
        echo ""
        echo "  ⚠️  Alguns erros (não crítico)"
    fi
    echo ""
} | tee "$LOG_FILE"

exit 0