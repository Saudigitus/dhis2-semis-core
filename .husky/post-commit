#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Evita loop infinito
[ "$SEMIS_SUBTREE_SYNC" = "1" ] && exit 0

# -------------------------------------------------
# Configuração
# -------------------------------------------------
SUBTREES="
src/modules/attendance/src|https://github.com/Saudigitus/dhis2-semis-attendance.git
src/modules/enrollment/src|https://github.com/Saudigitus/dhis2-semis-enrollment.git
src/modules/final-result/src|https://github.com/Saudigitus/dhis2-semis-final-result.git
src/modules/performance/src|https://github.com/Saudigitus/dhis2-semis-performance.git
src/modules/school-calendar/src|https://github.com/Saudigitus/dhis2-semis-school-calendar.git
src/modules/transfer/src|https://github.com/Saudigitus/dhis2-semis-transfer.git
src/modules/transfer-execute/src|https://github.com/Saudigitus/dhis2-semis-transfer-execute.git
"

# Branch alvo no repositório remoto
TARGET_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)"

CACHE_DIR=".git/subtree-cache"
mkdir -p "$CACHE_DIR"

# -------------------------------------------------
# Funções
# -------------------------------------------------

get_changed_modules() {
    git diff-tree --no-commit-id --name-only -r HEAD | \
        grep '^src/modules/' | \
        cut -d'/' -f1-3 | \
        sort -u
}

sync_module() {
    folder="$1"
    remote_url="$2"
    module_name=$(basename "$folder")

    cache_file="$CACHE_DIR/$module_name"
    current_hash=$(git log -1 --format=%T -- "$folder" 2>/dev/null || echo "none")
    cached_hash=$(cat "$cache_file" 2>/dev/null || echo "")

    if [ "$current_hash" = "$cached_hash" ] && [ -n "$cached_hash" ]; then
        echo "✨ $module_name — sem alterações (cache)"
        return
    fi

    temp_branch="subtree-$module_name-$(date +%s)"

    echo "🔄 Sincronizando $module_name → $TARGET_BRANCH"

    export SEMIS_SUBTREE_SYNC=1

    # Tentativa rápida
    if git subtree split \
        --prefix="$folder" \
        --branch="$temp_branch" \
        --rejoin; then

        if git push "$remote_url" "$temp_branch:$TARGET_BRANCH"; then
            echo "✅ $module_name sincronizado (--rejoin)"
            echo "$current_hash" > "$cache_file"
            git branch -D "$temp_branch" >/dev/null 2>&1
            return
        fi
    fi

    echo "↻ Fallback: regeneração completa (--ignore-joins)"

    if git subtree split \
        --prefix="$folder" \
        --branch="$temp_branch" \
        --ignore-joins && \
       git push "$remote_url" "$temp_branch:$TARGET_BRANCH"; then

        echo "✅ $module_name sincronizado (--ignore-joins)"
        echo "$current_hash" > "$cache_file"
    else
        echo "❌ Falha ao sincronizar $module_name"
        echo "💡 Manual:"
        echo "   git subtree split --prefix=$folder --ignore-joins --branch=temp"
        echo "   git push $remote_url temp:$TARGET_BRANCH"
        echo "   git branch -D temp"
    fi

    git branch -D "$temp_branch" >/dev/null 2>&1
}

# -------------------------------------------------
# Main
# -------------------------------------------------

changed_modules=$(get_changed_modules)

echo ""
echo "🌿 SEMIS | Subtree sync automático"
echo "➡ Branch local : $(git rev-parse --abbrev-ref HEAD)"
echo "➡ Branch remota: $TARGET_BRANCH"
echo ""

if [ -z "$changed_modules" ]; then
    echo "ℹ️ Nenhum módulo alterado"
    echo ""
    exit 0
fi

echo "📂 Módulos alterados:"
echo "$changed_modules"
echo ""

for line in $SUBTREES; do
    folder=$(echo "$line" | cut -d'|' -f1)
    remote=$(echo "$line" | cut -d'|' -f2)

    echo "$changed_modules" | grep -Fx "$folder" >/dev/null || continue
    sync_module "$folder" "$remote"
    echo ""
done

unset SEMIS_SUBTREE_SYNC

echo "🎉 Sincronização concluída!"
echo ""
