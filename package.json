    "build-unix": "node --max-old-space-size=8096 ./node_modules/.bin/d2-app-scripts build --no-verify",
    "start": "d2-app-scripts start --proxy  https://emis.dhis2.org/startracker",
    "test": "d2-app-scripts test",
    "deploy": "d2-app-scripts deploy",
    "push::enrollment": "bash -c 'git add src/modules/enrollment && git commit -m \"$1\" && git push && git subtree push --prefix=src/modules/enrollment enrollment \"$2\"' dummy",
    "pull::enrollment": "bash -c 'git pull && git subtree pull --prefix=src/modules/enrollment enrollment \"$1\"' dummy"
