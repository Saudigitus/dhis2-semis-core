{
  "compilerOptions": {
    "target": "es6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "dhis2-semis-components": [
        "src/libs/components/src"
      ],
      "dhis2-semis-functions": [
        "src/libs/functions/src"
      ],
      "dhis2-semis-types": [
        "src/libs/types/src"
      ],
      "dhis2-semis-enrollment": [
        "src/modules/enrollment/src"
      ],
      "dhis2-semis-performance": [
        "src/modules/performance/src"
      ],
      "@libs/*": [
        "src/libs/*"
      ],
      "@modules/*": [
        "src/modules/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}